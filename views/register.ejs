<%- include('partials/header') %>

<div class="row justify-content-center mt-3 mb-5">
  <div class="col-md-7">
    <div class="card shadow-sm border-0 p-4">
      <h3 class="card-title text-center mb-4 fw-bold text-success">สมัครสมาชิก ResQ Food</h3>
      <form id="registerForm">
        
        <div class="mb-3">
          <label class="form-label">ชื่อ - นามสกุล / ชื่อผู้ใช้งาน</label>
          <input type="text" id="name" class="form-control" required placeholder="นายสมชาย ใจดี">
        </div>

        <div class="mb-3">
          <label class="form-label">อีเมล</label>
          <input type="email" id="email" class="form-control" required placeholder="example@mail.com">
        </div>

        <div class="mb-3">
          <label class="form-label">รหัสผ่าน</label>
          <input type="password" id="password" class="form-control" required placeholder="••••••••">
        </div>

        <div class="mb-3">
          <label class="form-label">เบอร์โทรศัพท์</label>
          <input type="tel" id="phone" class="form-control" placeholder="0812345678">
        </div>

        <div class="mb-3">
          <label class="form-label fw-bold text-secondary">ประเภทผู้ใช้งาน (Role)</label>
          <select id="role" class="form-select" required onchange="toggleStoreDetails()">
            <option value="Customer">ผู้ซื้อ / บุคคลทั่วไป (Customer)</option>
            <option value="Business">ร้านค้า / ผู้ประกอบการ (Business)</option>
            <option value="Foundation">องค์กรการกุศล / มูลนิธิ (Foundation)</option>
          </select>
        </div>

        <!-- โซนข้อมูลร้านค้า (จะแสดงเฉพาะเมื่อเลือก Business หรือ Foundation) -->
        <div id="storeDetailsSection" class="p-3 bg-light rounded mb-3 d-none border">
          <h6 class="fw-bold text-success mb-3">🏢 ข้อมูลร้านค้า / สถาบัน</h6>
          <div class="mb-3">
            <label class="form-label">ชื่อร้านค้า หรือ ชื่อมูลนิธิ</label>
            <input type="text" id="storeName" class="form-control" placeholder="เช่น ร้านกาแฟสวนส้ม">
          </div>
          <div class="mb-2">
            <label class="form-label">ที่อยู่สำหรับรับสินค้า</label>
            <textarea id="address" class="form-control" rows="2" placeholder="เลขที่ ถนน แขวง/ตำบล..."></textarea>
          </div>
        </div>

        <button type="submit" class="btn btn-success w-100 py-2 mt-2">ยืนยันการสมัครสมาชิก</button>
      </form>
    </div>
  </div>
</div>

<script>
  // ฟังก์ชัน ซ่อน-แสดง ช่องกรอกข้อมูลร้านค้าตาม Role
  function toggleStoreDetails() {
    const role = document.getElementById('role').value;
    const storeSection = document.getElementById('storeDetailsSection');
    
    if (role === 'Business' || role === 'Foundation') {
      storeSection.classList.remove('d-none');
    } else {
      storeSection.classList.add('d-none');
    }
  }

  // ส่งข้อมูลสมัครสมาชิกไปที่ Backend API
  document.getElementById('registerForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const role = document.getElementById('role').value;
    const payload = {
      name: document.getElementById('name').value,
      email: document.getElementById('email').value,
      password: document.getElementById('password').value,
      phone: document.getElementById('phone').value,
      role: role
    };

    // หากเลือกเป็น Business หรือ Foundation ให้แนบ storeDetailsไปด้วย
    if (role === 'Business' || role === 'Foundation') {
      payload.storeDetails = {
        storeName: document.getElementById('storeName').value,
        address: document.getElementById('address').value
      };
    }

    try {
      const res = await fetch('/api/v1/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (res.ok) {
        // หากส่ง Token กลับมา สามารถบันทึกเข้า localStorage ได้ทันที
        if (data.token) {
          localStorage.setItem('token', data.token);
        }
        alert('สมัครสมาชิกสำเร็จ!');
        window.location.href = '/';
      } else {
        alert(data.message || 'เกิดข้อผิดพลาดในการสมัครสมาชิก');
      }
    } catch (err) {
      alert('ไม่สามารถเชื่อมต่อกับเซิร์ฟเวอร์ได้');
    }
  });
</script>

<%- include('partials/footer') %>