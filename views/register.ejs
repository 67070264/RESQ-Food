<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>สมัครสมาชิก | RESQ-Food</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header class="container nav">
    <a href="/" class="logo">
      <svg width="36" height="36" viewBox="0 0 36 36" aria-hidden="true">
        <circle cx="18" cy="18" r="18" fill="var(--accent)"/>
        <path d="M10 18.5l5.5 5.5L26 12.5" fill="none" stroke="#12233F" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      RESQ-Food
    </a>
    <nav class="nav__links">
      <a href="/login" class="btn btn--dark">เข้าสู่ระบบ</a>
    </nav>
  </header>

  <main class="container page-wrap">
    <div class="split-box">
      <div class="split-box__side">
        <div>
          <span class="badge-tag">เริ่มต้นใช้งานฟรี</span>
          <h2>เข้าร่วมเครือข่าย<br>ส่งต่ออาหารดี ๆ</h2>
          <p>เลือกบทบาทที่ตรงกับคุณ ไม่ว่าจะเป็นผู้ซื้อทั่วไป ร้านค้าพาร์ทเนอร์ หรือมูลนิธิ</p>
        </div>

        <div class="preview-pill">
          <div style="font-size:14px; color:#c5d2e8;">รองรับ 3 บทบาทผู้ใช้งาน</div>
          <div style="font-size:15px;">• <strong>Customer:</strong> จองอาหารลดราคาใกล้บ้าน</div>
          <div style="font-size:15px;">• <strong>Business:</strong> ลงขายอาหารเหลือท้ายวัน</div>
          <div style="font-size:15px;">• <strong>Foundation:</strong> ขอรับบริจาคอาหาร</div>
        </div>
      </div>

      <div class="split-box__form">
        <div class="form-head">
          <h1>สร้างบัญชีใหม่</h1>
          <p>มีบัญชีอยู่แล้ว? <a href="/login" style="color:var(--accent); font-weight:700;">เข้าสู่ระบบ</a></p>
        </div>

        <form id="registerForm">
          <div class="form-grid">
            <div class="form-group">
              <label for="name">ชื่อผู้ใช้งาน *</label>
              <input type="text" id="name" class="form-control" required placeholder="สมชาย ใจดี">
            </div>
            <div class="form-group">
              <label for="phone">เบอร์โทรศัพท์</label>
              <input type="tel" id="phone" class="form-control" placeholder="0812345678">
            </div>
          </div>

          <div class="form-group">
            <label for="email">อีเมล *</label>
            <input type="email" id="email" class="form-control" required placeholder="name@example.com">
          </div>

          <div class="form-group">
            <label for="password">รหัสผ่าน *</label>
            <input type="password" id="password" class="form-control" required placeholder="••••••••">
          </div>

          <div class="form-group">
            <label for="role">ประเภทผู้ใช้งาน (Role) *</label>
            <select id="role" class="form-control" required onchange="toggleStoreDetails()">
              <option value="Customer">ผู้ซื้อทั่วไป (Customer)</option>
              <option value="Business">ร้านค้า / ผู้ประกอบการ (Business)</option>
              <option value="Foundation">มูลนิธิ / องค์กรการกุศล (Foundation)</option>
            </select>
          </div>

          <!-- ซ่อน/แสดงอัตโนมัติตาม Role -->
          <div id="storeDetailsSection" class="store-box hidden">
            <div class="store-box__title">🏢 ข้อมูลร้านค้า / มูลนิธิ</div>
            <div class="form-group">
              <label for="storeName">ชื่อร้านค้า หรือ ชื่อมูลนิธิ</label>
              <input type="text" id="storeName" class="form-control" style="background:var(--white);" placeholder="เช่น เบเกอรี่ปากซอย">
            </div>
            <div class="form-group" style="margin-bottom:0;">
              <label for="address">ที่อยู่สำหรับรับอาหาร</label>
              <textarea id="address" class="form-control" style="background:var(--white);" placeholder="ระบุพิกัดหรือที่อยู่ร้าน"></textarea>
            </div>
          </div>

          <button type="submit" class="btn btn--accent btn--lg" style="width:100%; margin-top:8px;">
            ยืนยันการสมัครสมาชิก
          </button>
        </form>
      </div>
    </div>
  </main>

  <script>
    function toggleStoreDetails() {
      const role = document.getElementById('role').value;
      const storeSection = document.getElementById('storeDetailsSection');
      if (role === 'Business' || role === 'Foundation') {
        storeSection.classList.remove('hidden');
      } else {
        storeSection.classList.add('hidden');
      }
    }

    document.getElementById('registerForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const role = document.getElementById('role').value;
      const payload = {
        name: document.getElementById('name').value,
        email: document.getElementById('email').value,
        password: document.getElementById('password').value,
        phone: document.getElementById('phone').value,
        role: role
      };

      if (role === 'Business' || role === 'Foundation') {
        payload.storeDetails = {
          storeName: document.getElementById('storeName').value,
          address: document.getElementById('address').value
        };
      }

      try {
        const res = await fetch('/api/v1/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok) {
          if (data.token) localStorage.setItem('token', data.token);
          alert('🎉 สมัครสมาชิกสำเร็จ!');
          window.location.href = '/';
        } else {
          alert(data.message || 'เกิดข้อผิดพลาดในการสมัครสมาชิก');
        }
      } catch (err) {
        alert('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
      }
    });
  </script>
</body>
</html>